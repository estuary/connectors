
SELECT 0,
(
	SELECT * FROM (SELECT
		'id' = r.id,
		'bin''ary' = CAST(N'' AS XML).value('xs:base64Binary(sql:column("r.[bin''ary]"))', 'VARCHAR(MAX)')
	) AS d
	FOR JSON AUTO, INCLUDE_NULL_VALUES, WITHOUT_ARRAY_WRAPPER
) as flow_document
FROM quoted_binary AS r
JOIN #flow_temp_load_0 AS l
	 ON  l.id = r.id


