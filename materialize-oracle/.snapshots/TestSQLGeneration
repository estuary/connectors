--- Begin key_value createTargetTable ---
CREATE TABLE IF NOT EXISTS key_value (
	key1 NUMBER(38,0) NOT NULL,
	key2 BOOLEAN NOT NULL,
	"key!binary" RAW(2000) NOT NULL,
	array CLOB,
	binary BLOB,
	boolean BOOLEAN,
	field_with_projection CLOB,
	flow_published_at TIMESTAMP(9) WITH TIME ZONE NOT NULL,
	"integer" NUMBER(38,0),
	integerGt128Bit VARCHAR2(40 CHAR),
	integerGt256Bit VARCHAR2(78 CHAR),
	integerGt64Bit NUMBER(38,0),
	integerWithUserDDL DECIMAL(20),
	multiple CLOB,
	"nonAsciiκόσμε" CLOB,
	"number" BINARY_DOUBLE,
	numberCastToString CLOB,
	object CLOB,
	string CLOB,
	stringInteger NUMBER(38,0),
	stringInteger18Chars NUMBER(38,0),
	stringInteger38Chars NUMBER(38,0),
	stringInteger39Chars VARCHAR2(39 CHAR),
	stringInteger66Chars VARCHAR2(66 CHAR),
	stringInteger77Chars VARCHAR2(77 CHAR),
	stringNumber BINARY_DOUBLE,
	flow_document CLOB,
	PRIMARY KEY (key1, key2, "key!binary")
)--- End key_value createTargetTable ---

--- Begin delta_updates createTargetTable ---
CREATE TABLE IF NOT EXISTS delta_updates (
	theKey VARCHAR2(1000 CHAR),
	aValue NUMBER(38,0),
