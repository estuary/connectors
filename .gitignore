verify-affected-*
venv
*/**/.claude/
.claude/*.lock
tests/benchmark/materialize/runs/*
!tests/benchmark/materialize/runs/baselines
tests/benchmark/materialize/runs/baselines/*/run.*
# Go's `go mod vendor` output, which is generated and never committed.
vendor
# ...but estuary-cdk/vendor is a committed source tree: the forked Airbyte CDK.
!estuary-cdk/vendor
# Ignore compiled binaries named "connector", but allow directories named "connector"  
# when they are part of the expected "cmd/connector" structure for multi-package connectors.  
connector
!*/cmd/connector

# Ignore connector binaries built locally (binary name matches directory name)
materialize-*/materialize-*
source-*/source-*

.docker-cache/*
!.docker-cache/.keep
/.build/
*/target
**/.DS_Store


# top-level directory where we put flow binaries downloaded from the latest flow release
/flow-bin/

# Python type-checkingr, virtual environment, and cached bytecode.
/.mypy_cache
.pytest_cache
.venv/
__pycache__

# Python Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Generated by source-kafka's integration tests.
source-kafka/tests/test.generated.flow.yaml

# Written by the materialization test harness when a snapshot mismatches.
.snapshots/*.actual

# The repo-root uv.lock covers every workspace member, so a lock in a member
# directory is a stray from running uv there and would never be read. The root's
# lock, the one that is real, is outside this one-level pattern.
/*/uv.lock

# requests-cache backing files that a few connector test suites write into
# the working directory.
REQUEST_CACHE_PATH/
file::memory:*
