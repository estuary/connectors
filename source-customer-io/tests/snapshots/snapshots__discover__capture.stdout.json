        },
        "metrics": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "id",
        "created",
        "deduplicate_id",
        "metrics"
      ],
      "title": "Delivery",
      "type": "object",
