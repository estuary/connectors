                "kind": "SCALAR",
                "type": "DateTime"
              },
              {
                "name": "status",
                "kind": "NON_NULL",
                "type": "ProjectStatus"
              }
            ],
            "Initiative": [
              {
                "name": "id",
                "kind": "NON_NULL",
                "type": "ID"
              },
              {
                "name": "createdAt",
                "kind": "NON_NULL",
                "type": "DateTime"
              },
              {
                "name": "updatedAt",
                "kind": "NON_NULL",
                "type": "DateTime"
              },
              {
                "name": "archivedAt",
                "kind": "SCALAR",
                "type": "DateTime"
              },
              {
                "name": "status",
                "kind": "NON_NULL",
                "type": "InitiativeStatus"
              }
            ],
            "IssueLabel": [
              {
                "name": "id",
                "kind": "NON_NULL",
