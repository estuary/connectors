{
  "config_schema_json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/estuary/connectors/materialize-clickhouse/config",
    "properties": {
      "address": {
        "type": "string",
        "title": "Address",
        "description": "Host and port of the database (in the form of host[:port]). Default is 9000 if SSL is disabled, 9440 if SSL is enabled.",
        "order": 0
      },
      "database": {
        "type": "string",
        "title": "Database",
        "description": "Name of the ClickHouse database to materialize to.",
        "order": 1
      },
      "cluster": {
        "type": "string",
        "title": "Cluster",
        "description": "Name of a ClickHouse cluster, as listed in system.clusters. When set, each table is created as a Distributed table over a local table on every shard, rows are written directly to the shard that owns them, and the connector must be able to reach every node of the cluster. Leave blank for a single server or ClickHouse Cloud.",
        "order": 2
      },
      "hardDelete": {
        "type": "boolean",
        "title": "Hard Delete",
        "description": "If this option is enabled items deleted in the source will also be deleted from the destination. By default this is disabled and _meta/op in the destination will signify whether rows have been deleted (soft-delete).",
        "default": false,
        "nonsensitive": true,
        "order": 3
      },
      "credentials": {
        "oneOf": [
          {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://github.com/estuary/connectors/materialize-clickhouse/username-password",
            "properties": {
              "auth_type": {
                "type": "string",
                "const": "user_password",
                "default": "user_password",
                "order": 0
              },
              "username": {
                "type": "string",
                "title": "Username",
                "description": "Username for authentication.",
                "order": 0
              },
              "password": {
                "type": "string",
                "title": "Password",
                "description": "Password for authentication.",
                "order": 1,
                "secret": true
              }
            },
            "type": "object",
            "title": "Username and Password"
          }
        ],
        "type": "object",
        "title": "Authentication",
        "default": {
          "auth_type": "user_password"
        },
        "discriminator": {
          "propertyName": "auth_type"
        },
        "order": 4
      },
      "syncSchedule": {
        "properties": {
          "syncFrequency": {
            "type": "string",
            "enum": [
              "0s",
              "30s",
              "1m",
              "2m30s",
              "5m",
              "15m",
              "20m",
              "30m",
              "1h",
              "2h",
              "4h"
            ],
            "title": "Sync Frequency",
            "description": "Frequency at which transactions are executed when the materialization is fully caught up and streaming changes. May be enabled only for certain time periods and days of the week if configured below; otherwise it is effective 24/7. Defaults to 30 minutes if unset.",
            "nonsensitive": true,
            "order": 0
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "description": "Timezone applicable to sync time windows and active days. Must be a valid IANA time zone name or +HH:MM offset.",
            "nonsensitive": true,
            "order": 1
          },
          "fastSyncStartTime": {
            "type": "string",
            "title": "Fast Sync Start Time",
            "description": "Time of day that transactions begin executing at the configured Sync Frequency. Prior to this time transactions will be executed more slowly. Must be in the form of '09:00'.",
            "nonsensitive": true,
            "order": 2,
            "pattern": "^(0?[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$"
          },
          "fastSyncStopTime": {
            "type": "string",
            "title": "Fast Sync Stop Time",
            "description": "Time of day that transactions stop executing at the configured Sync Frequency. After this time transactions will be executed more slowly. Must be in the form of '17:00'.",
            "nonsensitive": true,
            "order": 3,
            "pattern": "^(0?[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$"
          },
          "fastSyncEnabledDays": {
            "type": "string",
            "title": "Fast Sync Enabled Days",
            "description": "Days of the week that the configured Sync Frequency is active. On days that are not enabled, transactions will be executed more slowly for the entire day. Examples: 'M-F' (Monday through Friday, inclusive), 'M,W,F' (Monday, Wednesday, and Friday), 'Su-T,Th-S' (Sunday through Tuesday, inclusive; Thursday through Saturday, inclusive). All days are enabled if unset.",
            "nonsensitive": true,
            "order": 4
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Sync Schedule",
        "description": "Configure schedule of transactions for the materialization."
      },
      "advanced": {
        "properties": {
          "sslmode": {
            "type": "string",
            "enum": [
              "disable",
              "require",
              "verify-full"
            ],
            "title": "SSL Mode",
            "description": "Controls the TLS connection behavior.",
            "default": "verify-full"
          },
          "feature_flags": {
            "type": "string",
            "title": "Feature Flags",
            "description": "This property is intended for Estuary internal use. You should only modify this field as directed by Estuary support.",
            "nonsensitive": true
          },
          "no_flow_document": {
            "type": "boolean",
            "title": "Exclude Flow Document",
            "description": "When enabled the root document will not be required for standard updates.",
            "default": false,
            "nonsensitive": true
          },
          "local_table_suffix": {
            "type": "string",
            "title": "Local Table Suffix",
            "description": "Suffix appended to each table name to name the per-shard local table that backs it. Only used when a cluster is set.",
            "default": "_local",
            "nonsensitive": true
          },
          "topology_refresh_interval": {
            "type": "string",
            "title": "Topology Refresh Interval",
            "description": "How often the connector re-reads the cluster's shard layout from system.clusters. When the layout changes the connector restarts. Accepts duration strings like '5m' or '1h'. Only used when a cluster is set.",
            "default": "5m",
            "nonsensitive": true,
            "pattern": "^[0-9]+(ms|s|m|h)$"
          },
          "insert_quorum_timeout": {
            "type": "string",
            "title": "Insert Quorum Timeout",
            "description": "How long a write waits for a majority of a shard's replicas to acknowledge it before failing. Accepts duration strings like '10m' or '30s'. Only used when a cluster is set.",
            "default": "10m",
            "nonsensitive": true,
            "pattern": "^[0-9]+(ms|s|m|h)$"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Advanced Options",
        "description": "Options for advanced users. You should not typically need to modify these.",
        "advanced": true
      }
    },
    "type": "object",
    "required": [
      "address",
      "database",
      "credentials"
    ],
    "title": "SQL Connection"
  },
  "resource_config_schema_json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/estuary/connectors/materialize-clickhouse/table-config",
    "properties": {
      "table": {
        "type": "string",
        "title": "Table",
        "description": "Name of the database table.",
        "x-collection-name": true
      },
      "delta_updates": {
        "type": "boolean",
        "title": "Delta Update",
        "description": "Should updates to this table be done via delta updates. Default is false.",
        "default": false,
        "nonsensitive": true,
        "x-delta-updates": true
      },
      "partition_by": {
        "type": "string",
        "title": "Partition By",
        "description": "Optional expression to use as the table's PARTITION BY clause, for example toYYYYMM(flow_published_at). Leave blank for ClickHouse's default single partition. Use a low-cardinality expression: ClickHouse recommends well under 1000 total partitions, and inserts spanning more than 100 partitions are rejected by default. Changing this value requires backfilling the binding, which drops and re-creates the table.",
        "advanced": true,
        "nonsensitive": true
      },
      "sharding_key": {
        "items": {
          "type": "string"
        },
        "type": "array",
        "title": "Sharding Key",
        "description": "Fields whose values choose which shard of the cluster a row is stored on. Must be a subset of the fields selected as the table's key. Leave blank to shard by the whole key. Only used when the endpoint names a cluster. Changing this value requires backfilling the binding.",
        "advanced": true
      }
    },
    "type": "object",
    "required": [
      "table"
    ],
    "title": "SQL Table"
  },
  "documentation_url": "https://go.estuary.dev/materialize-clickhouse"
}
