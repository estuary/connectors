{
  "config_schema_json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/estuary/connectors/materialize-smb/config",
    "properties": {
      "host": {
        "type": "string",
        "title": "Host",
        "description": "Hostname or IP address of your SMB server.",
        "order": 0
      },
      "port": {
        "type": "integer",
        "maximum": 65535,
        "minimum": 1,
        "title": "Port",
        "description": "Port of your SMB server.",
        "default": 445,
        "nonsensitive": true,
        "order": 1
      },
      "share": {
        "type": "string",
        "title": "Share",
        "description": "Name of the SMB share to write to. Specify a share name without a path.",
        "order": 2
      },
      "username": {
        "type": "string",
        "title": "Username",
        "description": "Username for NTLM authentication.",
        "order": 3
      },
      "password": {
        "type": "string",
        "title": "Password",
        "description": "Password for NTLM authentication.",
        "order": 4,
        "secret": true
      },
      "domain": {
        "type": "string",
        "title": "Domain",
        "description": "Optional NTLM domain for your account.",
        "order": 5
      },
      "directory": {
        "type": "string",
        "title": "Directory",
        "description": "Folder inside the share to write files under. Accepts forward slashes or backslashes with or without a leading separator. Paths are normalized. Omit or leave empty for the share root.",
        "default": "/",
        "order": 6
      },
      "uploadInterval": {
        "type": "string",
        "enum": [
          "1s",
          "1m",
          "5m",
          "15m",
          "30m",
          "1h"
        ],
        "title": "Upload Interval",
        "description": "Frequency at which files will be uploaded. Must be a valid Go duration string.",
        "default": "5m",
        "nonsensitive": true,
        "order": 7
      },
      "fileSizeLimit": {
        "type": "integer",
        "title": "File Size Limit",
        "description": "Approximate maximum size of materialized files in bytes. Defaults to 10737418240 (10 GiB) if blank.",
        "nonsensitive": true,
        "order": 8
      },
      "csvConfig": {
        "properties": {
          "skipHeaders": {
            "type": "boolean",
            "title": "Skip Headers",
            "description": "Do not write headers to files.",
            "nonsensitive": true,
            "order": 2
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CSV Configuration",
        "description": "Configuration specific to materializing CSV files."
      },
      "advanced": {
        "properties": {
          "feature_flags": {
            "type": "string",
            "title": "Feature Flags",
            "description": "This property is intended for Estuary internal use. You should only modify this field as directed by Estuary support.",
            "nonsensitive": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Advanced Options",
        "description": "Options for advanced users. You should not typically need to modify these.",
        "advanced": true
      }
    },
    "type": "object",
    "required": [
      "host",
      "share",
      "username",
      "password",
      "uploadInterval"
    ],
    "title": "EndpointConfig"
  },
  "resource_config_schema_json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/estuary/connectors/filesink/resource",
    "properties": {
      "path": {
        "type": "string",
        "title": "Path",
        "description": "The path that objects will be materialized to.",
        "x-collection-name": true
      }
    },
    "type": "object",
    "required": [
      "path"
    ],
    "title": "ResourceConfig"
  },
  "documentation_url": "https://go.estuary.dev/materialize-smb"
}
