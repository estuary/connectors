  {
    "recommendedName": "Sessions",
    "resourceConfig": {
      "name": "Sessions",
      "interval": "PT5M"
    },
    "documentSchema": {
      "$defs": {
        "Meta": {
          "properties": {
            "op": {
              "default": "u",
              "description": "Operation type (c: Create, u: Update, d: Delete)",
              "enum": [
                "c",
                "u",
                "d"
              ],
              "title": "Op",
              "type": "string"
            },
            "row_id": {
              "default": -1,
